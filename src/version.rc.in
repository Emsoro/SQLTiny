// SQLTiny Windows 版本资源模板
// 经 configure_file(@ONLY) 生成 version.rc 并链接进 sqltiny_server,
// 使 exe 属性页(详细信息)显示产品名 / 版本 / 版权等元数据。
// 注意:变量必须用 @VAR@ 风格(配合 configure_file 的 @ONLY)。
#include <winver.h>

#define VER_FILEVERSION             @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
#define VER_FILEVERSION_STR         "@PROJECT_VERSION@.0\0"
#define VER_PRODUCTVERSION          VER_FILEVERSION
#define VER_PRODUCTVERSION_STR      VER_FILEVERSION_STR

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "SQLTiny Project"
            VALUE "FileDescription",  "SQLTiny MySQL wire protocol server"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "SQLTiny Server"
            VALUE "LegalCopyright",   "Apache License 2.0"
            VALUE "OriginalFilename", "sqltiny_server.exe"
            VALUE "ProductName",      "SQLTiny"
            VALUE "ProductVersion",   "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
